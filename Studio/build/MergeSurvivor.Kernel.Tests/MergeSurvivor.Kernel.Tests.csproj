<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Validates the kernel contracts in Studio/kernel. These tests are the reason the
    schemas are contracts rather than documentation: they check that every valid
    fixture is accepted, that every deliberately-broken fixture is rejected for the
    specific reason it was written to trip, and that cross-file rules JSON Schema
    cannot express (agent references resolving, nobody holding write access to CI)
    still hold.

    Kept separate from Core.Tests because it tests the studio, not the game.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="JsonSchema.Net" Version="7.2.3" />
  </ItemGroup>

</Project>
