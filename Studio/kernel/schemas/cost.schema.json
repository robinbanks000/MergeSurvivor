{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mergesurvivor.studio/kernel/cost.schema.json",
  "title": "Cost control",
  "description": "Budgets and spend for an autonomous studio that runs unattended overnight. A solo founder cannot watch the meter, so the kernel enforces a hard stop rather than trusting agents to be frugal.",
  "oneOf": [
    { "$ref": "#/$defs/budgetRegistry" },
    { "$ref": "#/$defs/spendRecord" }
  ],
  "$defs": {
    "budgetRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "updatedAt", "budgets"],
      "properties": {
        "kind": { "const": "budget-registry" },
        "version": { "type": "integer", "minimum": 1 },
        "updatedAt": { "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/timestamp" },
        "budgets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/budget" }
        }
      }
    },

    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "periodDays", "softWarnUsd", "hardStopUsd", "onHardStop"],
      "properties": {
        "id": { "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/budgetId" },
        "scope": { "type": "string", "enum": ["studio", "agent", "task"] },
        "agent": { "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/agentId" },
        "periodDays": { "type": "integer", "minimum": 1, "maximum": 365 },
        "softWarnUsd": {
          "description": "Crossing this raises a notice in the daily digest but changes nothing.",
          "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/usd"
        },
        "hardStopUsd": {
          "description": "Crossing this halts dispatch. Must be >= softWarnUsd; JSON Schema cannot compare siblings, so KernelCrossCheckTests enforces it.",
          "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/usd"
        },
        "onHardStop": {
          "description": "pause keeps in-flight work and stops new dispatch; stop abandons in-flight work too. Neither may be 'continue' — a budget with no teeth is a comment.",
          "type": "string",
          "enum": ["pause", "stop"]
        },
        "maxConcurrentTasks": { "type": "integer", "minimum": 1, "maximum": 10 },
        "note": { "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/nonEmptyString" }
      },
      "allOf": [
        {
          "description": "An agent-scoped budget must say which agent it governs.",
          "if": {
            "properties": { "scope": { "const": "agent" } },
            "required": ["scope"]
          },
          "then": { "required": ["agent"] }
        },
        {
          "description": "A studio-wide budget governs everyone and must not name one agent.",
          "if": {
            "properties": { "scope": { "const": "studio" } },
            "required": ["scope"]
          },
          "then": { "not": { "required": ["agent"] } }
        }
      ]
    },

    "spendRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "at", "budgetId", "actor", "usd"],
      "properties": {
        "kind": { "const": "spend-record" },
        "at": { "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/timestamp" },
        "budgetId": { "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/budgetId" },
        "actor": { "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/actorId" },
        "taskId": { "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/taskId" },
        "usd": { "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/usd" },
        "model": { "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/nonEmptyString" },
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "runtime": { "type": "string", "enum": ["claude-code-subagent", "github-action"] }
      }
    }
  }
}
