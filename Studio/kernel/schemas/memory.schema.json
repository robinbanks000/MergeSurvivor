{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mergesurvivor.studio/kernel/memory.schema.json",
  "title": "Memory layer registry",
  "description": "Declares the five memory layers, who may write each, and the size budget that keeps them readable. Memory that only grows stops being memory and becomes noise, so every layer names a compaction owner.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updatedAt", "layers"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "updatedAt": { "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/timestamp" },
    "layers": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/layer" }
    }
  },
  "$defs": {
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "name", "path", "writePolicy", "writers", "budget", "compactionOwner"],
      "properties": {
        "layer": { "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/memoryLayer" },
        "name": { "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/nonEmptyString" },
        "path": { "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/pathGlob" },
        "writePolicy": {
          "type": "string",
          "enum": ["human-only", "append-only", "mutable", "write-once"]
        },
        "writers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/actorId" },
          "uniqueItems": true
        },
        "budget": { "$ref": "#/$defs/budget" },
        "compactionOwner": { "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/actorId" },
        "loadedByDefault": {
          "description": "True only for the constitution. Everything else is loaded as the slice a task needs, never wholesale, or agents drown in their own history.",
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "description": "L0 is the constitution: pillars, non-goals, architecture. Only the founder writes it.",
          "if": {
            "properties": { "layer": { "const": "L0" } },
            "required": ["layer"]
          },
          "then": {
            "properties": {
              "writePolicy": { "const": "human-only" },
              "writers": { "const": ["human"] },
              "loadedByDefault": { "const": true }
            },
            "required": ["loadedByDefault"]
          }
        },
        {
          "description": "L1 holds decisions. Append-only so a contradiction becomes visible as a superseding ADR instead of vanishing in an edit.",
          "if": {
            "properties": { "layer": { "const": "L1" } },
            "required": ["layer"]
          },
          "then": {
            "properties": { "writePolicy": { "const": "append-only" } }
          }
        },
        {
          "description": "L3 is evidence: test runs, sim reports, profiles. Write-once, because rewriting evidence after the fact is how a system starts lying to itself.",
          "if": {
            "properties": { "layer": { "const": "L3" } },
            "required": ["layer"]
          },
          "then": {
            "properties": { "writePolicy": { "const": "write-once" } }
          }
        }
      ]
    },

    "budget": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "maxWords": { "type": "integer", "minimum": 1 },
        "maxEntries": { "type": "integer", "minimum": 1 },
        "retentionDays": { "type": "integer", "minimum": 1 },
        "note": { "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/nonEmptyString" }
      }
    },

    "record": {
      "description": "A single memory write, referenced by memory.written events.",
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "path", "writtenBy", "at"],
      "properties": {
        "layer": { "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/memoryLayer" },
        "path": { "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/pathGlob" },
        "writtenBy": { "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/actorId" },
        "at": { "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/timestamp" },
        "taskId": { "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/taskId" },
        "summary": { "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/nonEmptyString" },
        "promotedToTest": {
          "description": "Set when a lesson has been turned into a test or analyzer rule. A lesson that can be enforced should stop being remembered.",
          "type": "boolean"
        }
      }
    }
  }
}
