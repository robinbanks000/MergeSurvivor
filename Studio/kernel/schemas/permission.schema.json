{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mergesurvivor.studio/kernel/permission.schema.json",
  "title": "Permission matrix",
  "description": "Write access granted per division, not per agent. A hundred individual grants would drift from the roster within weeks and nobody would notice; thirteen division grants stay reviewable, and each agent inherits its division's scope or narrows it. The orchestrator checks this before dispatch and CI checks the PR diff against it afterwards.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updatedAt", "humanExclusivePaths", "grants"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "updatedAt": { "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/timestamp" },
    "humanExclusivePaths": {
      "description": "Paths only the founder may write. Must include .github/workflows/** and Studio/build/** — the workflow calls gate-g2.sh, so write access to either is write access to the gates themselves. KernelCrossCheckTests enforces both entries and that no grant overlaps this list.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/pathGlob" },
      "uniqueItems": true
    },
    "grants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/grant" }
    }
  },
  "$defs": {
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["division", "write"],
      "properties": {
        "division": { "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/divisionId" },
        "write": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/pathGlob" },
              {
                "description": "Belt and braces alongside the cross-check: no write grant may name the CI directory at all.",
                "not": { "pattern": "^\\.github/" }
              }
            ]
          },
          "uniqueItems": true
        },
        "read": { "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/pathGlobList" },
        "append": {
          "description": "Paths a division may add to but never rewrite, such as the lessons log.",
          "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/pathGlobList"
        }
      }
    },
    "denial": {
      "description": "Recorded when a dispatch or a diff was refused for reaching outside scope.",
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "attemptedPath", "at", "reason"],
      "properties": {
        "agent": { "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/agentId" },
        "division": { "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/divisionId" },
        "attemptedPath": { "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/pathGlob" },
        "at": { "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/timestamp" },
        "taskId": { "$ref": "https://mergesurvivor.studio/kernel/common.schema.json#/$defs/taskId" },
        "reason": {
          "type": "string",
          "enum": ["outside-write-scope", "human-exclusive-path", "no-grant-for-division", "agent-dormant", "budget-exhausted"]
        }
      }
    }
  }
}
